# ==============================================================================
# VoiceBill AI - Backend Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="VoiceBill AI"
API_V1_STR="/api"
SECRET_KEY="change-this-secret-key-in-production-use-a-strong-random-key"
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Settings (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voicebill_db"

# CORS Settings (JSON array of allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
